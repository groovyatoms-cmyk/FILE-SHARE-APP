# P2P File Share — environment configuration
# Copy this file to .env (root, for docker-compose) and/or client/.env.local
# and server/.env for local development, then fill in real values.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Client (Vite) — all variables must be prefixed VITE_ to be exposed to the
# browser bundle. See client/vite.config.ts and client/src/vite-env.d.ts.
# ---------------------------------------------------------------------------

VITE_APP_NAME="P2P File Share"

# WebSocket URL of the signaling server. Use wss:// in production.
VITE_SIGNALING_URL=ws://localhost:8080

# STUN server used for NAT traversal (no credentials required).
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# TURN server, used as a fallback relay when a direct P2P connection cannot
# be established (symmetric NAT, restrictive firewalls). Optional, but
# strongly recommended for production — without a TURN server some device
# pairs will simply be unable to connect.
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Default session lifetime, in seconds (10 min - 1 hour). Also configurable
# per-transfer from Settings in the UI.
VITE_SESSION_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Signaling server (server/src/server.ts)
# ---------------------------------------------------------------------------

# Port the signaling WebSocket/HTTP server listens on.
PORT=8080

# Comma-separated list of allowed browser origins for the WebSocket upgrade
# (CORS-equivalent check for WebSocket). Leave empty to allow any origin
# (fine for local development; set explicitly in production), or use "*".
ALLOWED_ORIGINS=http://localhost:5173

# development | production — affects log verbosity (see server/src/utils/logger.ts).
NODE_ENV=development
